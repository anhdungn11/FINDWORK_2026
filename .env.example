# FINDWORK DEV & TEST ENVIRONMENT CONFIGURATION
# Fail-closed safety: writes are DISABLED by default.

# To enable writes for the controlled DEV demo session on port 5176:
# VITE_ENABLE_WORKSPACE_WRITES=true
# VITE_ENABLE_LIVE_WRITES=true

# Server ports
# VITE_PORT=5176
# VITE_BACKEND_PORT=3000
# VITE_BACKEND_TARGET=http://127.0.0.1:3000
