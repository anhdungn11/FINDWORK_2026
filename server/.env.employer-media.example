# Copy to .env.employer-media.local (ignored by Git). Never point this at findwork_dev or findwork_test.
NODE_ENV=test
PORT=3002
API_PREFIX=api/v1
CORS_ORIGINS=http://127.0.0.1:5177,http://localhost:5177
COMPANY_MEDIA_STORAGE_DIR=C:\ABSOLUTE\PRIVATE\MEDIA_DIR
DATABASE_URL=postgresql://media_user:REPLACE_ME@127.0.0.1:5432/findwork_employer_media_3002?schema=public
FINDWORK_EXPECTED_DATABASE=findwork_employer_media_3002
JWT_ACCESS_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
REFRESH_TOKEN_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
EMAIL_DELIVERY_MODE=disabled
EMAIL_WORKER_ENABLED=false
EMAIL_INVITATION_DELIVERY_ENABLED=false
# Enable only with a verified Resend sender, authorized mailbox and reachable frontend HTTPS pages.
# EMAIL_ACTIVE_KEY_ID=
# EMAIL_KEYRING_JSON=
# EMAIL_RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_VERIFY_URL=
# EMAIL_INVITATION_URL=
# Optional provider-backed AI. Leave blank until real server-side credentials and current model pricing are supplied.
# FINDWORK_AI_PROVIDER=openai
# FINDWORK_AI_API_KEY=
# FINDWORK_AI_MODEL=
# FINDWORK_AI_INPUT_USD_PER_MILLION=
# FINDWORK_AI_OUTPUT_USD_PER_MILLION=
# FINDWORK_AI_TRANSCRIPTION_MODEL=
# FINDWORK_AI_TRANSCRIPTION_MAX_COST_MICROS=
