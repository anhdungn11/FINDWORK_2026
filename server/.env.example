NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5176,http://127.0.0.1:5176

# Use a dedicated development database. Never commit a real password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/findwork_dev?schema=public
# Authentication
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET

# Keep disabled until Resend, encryption keyring, HTTPS invitation URL and worker are configured.
EMAIL_INVITATION_DELIVERY_ENABLED=false
# Acceptance page reads the browser #token fragment and POSTs it to the API.
EMAIL_INVITATION_URL=
