NODE_ENV=test
PORT=3101
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173

# Create a separate local database and test-only account before use.
# Replace the placeholder password; never point this URL at findwork_dev.
DATABASE_URL=postgresql://findwork_test_user:REPLACE_TEST_PASSWORD@127.0.0.1:5432/findwork_test?schema=public
JWT_ACCESS_SECRET=REPLACE_WITH_A_UNIQUE_TEST_ACCESS_SECRET_32_CHARS_MIN
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=REPLACE_WITH_A_DIFFERENT_TEST_PEPPER_32_CHARS_MIN
EMAIL_DELIVERY_MODE=disabled
EMAIL_WORKER_ENABLED=false
EMAIL_INVITATION_DELIVERY_ENABLED=false
